{
    "name": "dealni/dealnibot",
    "description": "Assistente de IA para grupos do Telegram, com integração ao OpenRouter.",
    "license": "proprietary",
    "require": {
        "php": ">=8.5.12 <8.6",
        "ext-curl": "*",
        "ext-pdo": "*",
        "ext-redis": "^6.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "monolog/monolog": "^3",
        "ext-ctype": "*",
        "ext-filter": "*",
        "psr/log": "^3",
        "ext-pdo_pgsql": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/Support/"
        },
        "classmap": [
            "tests/Support/BancoTeste.php"
        ]
    },
    "config": {
        "platform": {
            "php": "8.5.12"
        },
        "platform-check": true,
        "allow-plugins": {}
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "phpstan/phpstan": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.95",
        "rector/rector": "^2.7",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "maglnet/composer-require-checker": "^4.24",
        "icanhazstring/composer-unused": "^0.9",
        "editorconfig-checker/editorconfig-checker": "^11.0"
    },
    "scripts": {
        "install-macos": "scripts/install/instalar_macos.sh",
        "install-linux": "scripts/install/instalar_linux.sh",
        "setup:dev": "bash scripts/install/setup_dev.sh",
        "provision:host": "bash scripts/install/provision_host.sh",
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php scripts/quality/run_tests.php"
        ],
        "test:unit": [
            "Composer\\Config::disableProcessTimeout",
            "@php scripts/quality/run_tests.php --testsuite Unit"
        ],
        "test:integration": [
            "Composer\\Config::disableProcessTimeout",
            "@php scripts/quality/run_tests.php --testsuite Integration"
        ],
        "test:contract": [
            "Composer\\Config::disableProcessTimeout",
            "@php scripts/quality/run_tests.php --testsuite Contract"
        ],
        "test:security": [
            "Composer\\Config::disableProcessTimeout",
            "@php scripts/quality/run_tests.php --testsuite Security"
        ],
        "test:performance": [
            "Composer\\Config::disableProcessTimeout",
            "@php scripts/quality/run_tests.php --testsuite Performance"
        ],
        "test:smoke": "@php scripts/quality/run_smoke.php",
        "typecheck": "phpstan analyse --memory-limit=1G",
        "format": "PHP_CS_FIXER_FUTURE_MODE=1 php-cs-fixer fix",
        "format:check": "PHP_CS_FIXER_FUTURE_MODE=1 php-cs-fixer check --diff --format=txt",
        "check:editorconfig": "ec",
        "check:shell": "bash scripts/quality/check_shell.sh",
        "check:security": "@php scripts/quality/run_semgrep.php",
        "rector": "rector process --dry-run --no-progress-bar",
        "check:config": "@composer validate --strict --check-lock --no-check-publish",
        "check:config:production": "@php scripts/quality/check_production_config.php",
        "check:config:examples": [
            "@php scripts/quality/check_config_examples.php",
            "@php scripts/quality/check_fpm_environment.php"
        ],
        "check:env": "@php scripts/quality/check_env.php",
        "check:postgres": "@php scripts/quality/check_postgres.php",
        "check:docs": "@php scripts/quality/check_doc_links.php",
        "check:tests": "@php scripts/quality/check_taxonomia_testes.php",
        "check:complexity": [
            "@php scripts/quality/check_tamanho.php",
            "@php scripts/quality/check_linhas_funcao.php"
        ],
        "complexity:baseline": [
            "@php scripts/quality/check_tamanho.php --atualizar-baseline",
            "@php scripts/quality/check_linhas_funcao.php --atualizar-baseline"
        ],
        "check:strict-types": "@php scripts/quality/check_strict_types.php",
        "check:duplication": "@php scripts/quality/run_phpcpd.php",
        "duplication:baseline": "@php scripts/quality/run_phpcpd.php --atualizar-baseline",
        "check:deps:undeclared": "composer-require-checker check --config-file=composer-require-checker.json",
        "check:dead-code": "@php scripts/quality/run_composer_unused.php",
        "check:licenses": "@php scripts/quality/check_licenses.php",
        "check:gitleaks": "bash scripts/quality/check_gitleaks.sh",
        "check:vulnerabilities": "@php scripts/quality/composer_audit_retry.php",
        "check:deploy-guards": [
            "bash scripts/quality/check_deploy_guard.sh",
            "bash scripts/quality/check_release_guards.sh"
        ],
        "check:workflows": "@php scripts/quality/check_workflows.php",
        "check:runtime": "bash scripts/quality/check_php_versions.sh runtime",
        "check:toolchain": [
            "Composer\\Config::disableProcessTimeout",
            "bash scripts/quality/check_php_versions.sh"
        ],
        "deps:outdated": "@composer outdated --direct --no-interaction",
        "release:check": "scripts/deploy/release_check.sh",
        "deploy": "scripts/deploy/deploy.sh",
        "deploy:publish": "scripts/deploy/publicar.sh",
        "deploy:verify": "scripts/deploy/deploy_verify.sh",
        "rollback": "scripts/deploy/rollback.sh",
        "fpm:prepare": "bash scripts/deploy/preparar_fpm.sh",
        "db:migrate:deploy": "@php scripts/deploy/migrate.php",
        "db:migrate:status": "@php scripts/deploy/migrate.php --status",
        "db:backup": "scripts/deploy/db_backup.sh",
        "db:restore": "scripts/deploy/db_restore.sh",
        "db:restore:test": "scripts/deploy/db_restore_test.sh",
        "privacy:retention": "@php scripts/operacao/aplicar_retencao.php",
        "check": [
            "@check:config",
            "@check:config:production",
            "@check:config:examples",
            "@check:env",
            "@check:postgres",
            "@check:editorconfig",
            "@check:shell",
            "@check:docs",
            "@typecheck",
            "@format:check",
            "@test"
        ],
        "check:all": [
            "Composer\\Config::disableProcessTimeout",
            "node scripts/quality/validation-runner.mjs --proof check:all -- composer check:all:run"
        ],
        "check:all:run": [
            "Composer\\Config::disableProcessTimeout",
            "@check:base",
            "@test"
        ],
        "check:online": [
            "@check:vulnerabilities",
            "npm run check:vulnerabilities"
        ],
        "check:ci-local": [
            "Composer\\Config::disableProcessTimeout",
            "node scripts/quality/validation-runner.mjs --proof check:all -- composer check:ci-local:run"
        ],
        "check:ci-local:run": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv CI=1",
            "@check:all:run",
            "@check:online"
        ],
        "check:base": [
            "Composer\\Config::disableProcessTimeout",
            "@check:runtime",
            "@check:tests",
            "@check:complexity",
            "@check:strict-types",
            "@check:deploy-guards",
            "@check:licenses",
            "@check:gitleaks",
            "npm run test:quality-tools",
            "@check:config",
            "@check:config:production",
            "@check:config:examples",
            "@check:env",
            "@check:postgres",
            "@check:editorconfig",
            "@check:shell",
            "@check:docs",
            "@typecheck",
            "@format:check",
            "@check:deps:undeclared",
            "@check:dead-code",
            "@check:security",
            "@check:duplication"
        ]
    }
}
