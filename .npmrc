# Versão exata no manifesto: as dependências de hook ficam pinadas sem faixa em
# package.json, e isto evita que um `npm install <pacote>` grave um `^` e
# reintroduza atualização silenciosa entre um checkout e outro. Não há gate que
# cobre o pino sozinho: quem cobra é esta flag mais a revisão do diff.
save-exact=true
save-prefix=

# engines declara os mínimos e as majors aceitas. O CI e o helper dos
# instaladores exigem o npm exato de packageManager para reproduzir a instalação.
engine-strict=true

# Dependência nova com lifecycle script não entra silenciosamente: o postinstall
# do Lefthook é explicitamente negado em package.json#allowScripts, e qualquer
# outra dependência precisa ser revisada e fixada ali antes de instalar.
# Sem esta flag o npm apenas avisa e segue.
strict-allow-scripts=true

# Instalação não duplica o gate explícito de segurança. O endpoint de advisory
# do registry teve respostas 503 e conexões presas; os limites abaixo mantêm
# retries de leituras idempotentes, mas fazem a falha aparecer dentro do timeout
# do job em vez de cancelar toda a workflow.
audit=false
fetch-retries=3
fetch-retry-mintimeout=5000
fetch-retry-maxtimeout=30000
fetch-timeout=60000
