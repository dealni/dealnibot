[Unit]
Description=Aviso de encerramento do DealniBot no privado
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
ExecStart=/usr/bin/php8.5 -d display_errors=0 -d log_errors=0 -d zend.exception_ignore_args=1 /usr/local/lib/dealnibot-encerramento/responder_encerramento.php
LoadCredential=telegram.token:/etc/dealnibot-encerramento/telegram.token
StateDirectory=dealnibot-encerramento
StateDirectoryMode=0700
UMask=0077
DynamicUser=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=-/var/www/dealnibot -/var/backups/servicos-desativados/dealnibot
InaccessiblePaths=-/etc/dealnibot -/var/lib/dealnibot -/var/backups/dealnibot -/var/log/php8.5-fpm-dealnibot
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
