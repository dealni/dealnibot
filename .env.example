# Contrato de ambiente do host. Instale como /etc/dealnibot/environment.
# Substitua pelo domínio HTTPS desta instalação antes de registrar o webhook.
DEALNI_PUBLIC_BASE_URL=https://bot.example.com
# Opcional: usuário do seu bot no Telegram, sem @. Vazio desativa o redirecionamento.
DEALNI_BOT_USERNAME=
DEALNI_SNAPSHOTS_DIR=/var/backups/dealnibot
DEALNI_SNAPSHOTS_MANTER=7
PHP85_BIN=/usr/bin/php8.5
# Redis opcional; ausente usa 127.0.0.1:6380 sem senha.
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=

# PostgreSQL obrigatório: credenciais separadas do DSN.
DEALNI_DB_DSN="pgsql:host=/var/run/postgresql;dbname=dealnibot"
DEALNI_DB_USER=dealnibot
DEALNI_DB_PASSWORD=

# Opcional: chat que recebe o aviso de falha do snapshot (vazio desliga).
# DEALNI_ALERTA_CHAT_ID=
